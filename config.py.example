"""Configuration settings for the extractor.

COPY THIS FILE TO config.py before running:
    copy config.py.example config.py     (Windows)
    cp   config.py.example config.py     (Linux/macOS)

config.py is gitignored so machine-specific settings and any hosted-provider
credentials never reach the repository. The defaults below need no credentials
at all: they talk to a local Ollama server.
"""

import os

from openai import OpenAI

# API Configuration -- overridable per-run so a model-comparison sweep or a
# switch of provider doesn't require editing this file, e.g.:
#   set PHARMA_EXTRACTOR_MODEL=qwen2.5:7b && python run.py ...
#
# The default is a local Ollama server: no per-token cost, no rate limits, and
# no regulatory PDFs leaving the machine -- which is what a multi-day full-corpus
# run needs. Ollama ignores the API key, so the placeholder below is not a
# secret. To use a hosted OpenAI-compatible provider instead, set all three env
# vars; never hard-code a live token here, since this tree is published.
API_BASE_URL = os.environ.get("PHARMA_EXTRACTOR_BASE_URL", "http://localhost:11434/v1")
API_KEY = os.environ.get("PHARMA_EXTRACTOR_API_KEY", "ollama")
DEFAULT_MODEL = os.environ.get("PHARMA_EXTRACTOR_MODEL", "mistral")


# Processing Configuration
SAFE_DELAY = float(os.environ.get("PHARMA_EXTRACTOR_SAFE_DELAY", "1"))  # Seconds between API calls to avoid rate limits (0 is fine for local Ollama)
DEFAULT_TEMPERATURE = 0.1

# How often the in-progress Excel is rewritten from the checkpoint. Every
# record is checkpointed to JSONL regardless; this only controls how fresh the
# spreadsheet is if you look at it mid-run.
EXCEL_FLUSH_EVERY = int(os.environ.get("PHARMA_EXTRACTOR_EXCEL_FLUSH_EVERY", "10"))

# Largest slice of monograph text sent to the model in one call.
#
# This has to fit inside the model's context window alongside the prompt and
# the answer, and overflow is NOT an error: the server silently drops the
# excess, so the model answers from a fragment of the document and starts
# summarising whatever it can see. That is what produced prose in the
# comma-separated list fields.
#
# Ollama's default context is 4096 tokens (~16k characters), which this 6000
# leaves comfortable room inside. Raise BOTH together -- e.g. set
# OLLAMA_CONTEXT_LENGTH=16384 and PHARMA_EXTRACTOR_MAX_SECTION_CHARS=20000 --
# to feed the model more of each section and recover the recall a small window
# costs you.
MAX_SECTION_CHARS = int(os.environ.get("PHARMA_EXTRACTOR_MAX_SECTION_CHARS", "6000"))

# Page Extraction Settings
METADATA_PAGES = [0]  # Page 1 for metadata
WARNINGS_PAGES = [3, 5]  # Pages 4 and 6 for warnings (0-indexed)
INDICATIONS_PAGES = [1, 3]  # Pages 2 and 4 for indications (0-indexed)
TOC_SEARCH_PAGES = 3  # First 3 pages for TOC
DEFAULT_ADVERSE_START_PAGE = 9
DEFAULT_ADVERSE_END_PAGE_OFFSET = 5  # Start + 5 pages if next section not found

# Output Settings
OUTPUT_COLUMN_ORDER = [
    "ID", 
    "Brand Name", 
    "Company", 
    "Initial Authorization",
    "Revision Date", 
    "Ingredients", 
    "Dosage",
    "Indications",
    "Contraindications",
    "Serious Warnings",
    "Adverse Events", 
    "Drug Interactions",
    "Liver Dose Adjustment",
    "Kidney Dose Adjustment",
    "Pharmacokinetics",
    "Metabolism",
    "Elimination",
    "Pharmacodynamics",
    "Pregnancy Recommendation",
    "Pregnancy Summary",
    "Breastfeeding Recommendation",
    "Breastfeeding Summary"
]

INDICATIONS_OUTPUT_FOLDER = "indications"
CONTRAINDICATIONS_OUTPUT_FOLDER = "contraindications"
WARNINGS_OUTPUT_FOLDER = "warnings"
ADVERSE_EVENTS_OUTPUT_FOLDER = "adverse_events"
DRUG_INTERACTIONS_OUTPUT_FOLDER = "drug_interactions"
LIVER_OUTPUT_FOLDER = "liver"
KIDNEY_OUTPUT_FOLDER = "kidney"
PK_OUTPUT_FOLDER = "pharmacokinetics_summaries"
METABOLISM_OUTPUT_FOLDER = "metabolism"
ELIMINATION_OUTPUT_FOLDER = "elimination"
PD_OUTPUT_FOLDER = "pharmacodynamics_summaries"
PREGNANCY_OUTPUT_FOLDER = "pregnancy_summaries"
BREASTFEEDING_OUTPUT_FOLDER = "breastfeeding_summaries"

# Initialize OpenAI client. timeout + max_retries=0 so a stuck request fails
# fast instead of hanging indefinitely -- api_client.py's own retry loop
# handles retrying, so the SDK's built-in retries would just double up.
client = OpenAI(
    base_url=API_BASE_URL,
    api_key=API_KEY,
    timeout=240,
    max_retries=0,
)